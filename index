    // ⚠️ GANTI URL DI BAWAH INI DENGAN URL WEB APP APPS SCRIPT KAMU (.exec)
    const URL_APPS_SCRIPT = "GANTI_DENGAN_URL_WEB_APP_APPS_SCRIPT_KAMU";

    let appData = { berita: [], profil: [] };
    let isHovered = false;
    let scrollSpeed = 0.5;

    document.addEventListener('DOMContentLoaded', () => { 
      loadDataFromGitHub(); 
      initSmoothAutoScroll();
      initSholatWidget();
    });

    // AMBIL DATA DARI GOOGLE APPS SCRIPT VIA FETCH
    function loadDataFromGitHub() {
      fetch(URL_APPS_SCRIPT + "?action=getPublicData")
        .then(response => response.json())
        .then(res => {
          appData = res;
          renderHeaderLogo();
          renderPublicNews();
          renderTickerData();
          renderTerkiniDanTerpopuler();
          document.getElementById('loadingOverlay').style.display = 'none';
          
          setTimeout(() => {
            const bannerBox = document.querySelector('.hero-image-banner-box');
            if (bannerBox) bannerBox.classList.add('slide-up-active');
          }, 100);
        })
        .catch(err => {
          console.error("Gagal memuat data:", err);
          document.getElementById('loadingOverlay').style.display = 'none';
        });
    }

    function fixDriveUrl(url) {
      if (!url) return '';
      if (url.includes('drive.google.com')) {
        let match = url.match(/\/d\/([a-zA-Z0-9_-]+)/);
        if (match && match[1]) return 'https://lh3.googleusercontent.com/d/' + match[1];
      }
      return url;
    }

    function renderHeaderLogo() {
      let logoUrl = "https://i.ibb.co.com/39hN7h3/kemenag-logo.png";
      if (appData.profil && appData.profil.length > 0 && appData.profil[0].logo) {
        let dbLogo = fixDriveUrl(appData.profil[0].logo);
        if(dbLogo.trim() !== '') logoUrl = dbLogo;
      }
      document.getElementById('headerLogo').src = logoUrl;
    }

    function renderTickerData() {
      const tickerContainer = document.getElementById('tickerContentContainer');
      let defaultItems = [
        "Akreditasi Madrasah <span>A</span>",
        "Indeks Kedisiplinan <span>98,5%</span>",
        "Juara Umum PORPROV <span>2026</span>"
      ];
      if (appData.profil && appData.profil.length > 0 && appData.profil[0].indeks) {
        let customIndeks = appData.profil[0].indeks.split(',');
        defaultItems = customIndeks.map(item => `<span>${item.trim()}</span>`);
      }
      tickerContainer.innerHTML = defaultItems.join(' • ');
    }

    function manualScroll(direction) {
      document.getElementById('newsSliderContainer').scrollBy({ left: direction, behavior: 'smooth' });
    }

    function initSmoothAutoScroll() {
      const container = document.getElementById('newsSliderContainer');
      const wrapper = document.getElementById('sliderWrapper');
      if (!container || !wrapper) return;
      wrapper.addEventListener('mouseenter', () => { isHovered = true; });
      wrapper.addEventListener('mouseleave', () => { isHovered = false; });
      function step() {
        if (!isHovered) {
          container.scrollLeft += scrollSpeed;
          if (container.scrollLeft + container.clientWidth >= container.scrollWidth - 2) container.scrollLeft = 0;
        }
        requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    function renderTerkiniDanTerpopuler() {
      const terkiniContainer = document.getElementById('terkiniContainer');
      const terpopulerContainer = document.getElementById('terpopulerContainer');
      if (!appData.berita || appData.berita.length === 0) {
        terkiniContainer.innerHTML = '<div class="text-muted text-center py-4 col-12">Belum ada berita.</div>';
        terpopulerContainer.innerHTML = '<div class="text-muted text-center py-4">Belum ada data.</div>';
        return;
