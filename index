      });
    });

    function renderPublicNews() {
      const container = document.getElementById('newsSliderContainer');
      if (!appData.berita || appData.berita.length === 0) {
        container.innerHTML = '<div class="text-center text-muted py-5 w-100">Belum ada berita.</div>';
        return;
      }
      container.innerHTML = appData.berita.map(b => `
        <div class="card-vertical-external">
          <div class="card-img-wrapper"><img src="${fixDriveUrl(b.gambar || b.Gambar)}" onerror="this.src='https://via.placeholder.com/210x280?text=Foto'"></div>
          <div class="card-text-wrapper"><span class="badge-kat">${b.kategori || 'Kegiatan'}</span><h6>${b.judul || 'Kegiatan'}</h6></div>
        </div>
      `).join('');
    }
  </script>
